{
  "name": "six-cities",
  "version": "4.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.js",
  "scripts": {
    "start": "npm run build && node ./dist/main.js",
    "start:pretty": "npm run build && node ./dist/main.js | pino-pretty",
    "build": "npm run clean && npm run compile",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -p tsconfig.json && node ./scripts/add-shebang.js",
    "clean": "rimraf dist",
    "ts": "ts-node",
    "cli": "node ./dist/cli/cli.js",
    "mock:server": "json-server --watch ./mocks/mock-server-data.json --port 3123",
    "openapi:lint": "redocly lint ./specification/specification.yml",
    "openapi:build": "redocly build-docs ./specification/specification.yml -o ./specification/api.html"
  },
  "devDependencies": {
    "@redocly/cli": "^2.72.1",
    "@types/convict": "^6.1.6",
    "@types/node": "18.16.3",
    "@typescript-eslint/eslint-plugin": "5.46.0",
    "@typescript-eslint/parser": "5.46.0",
    "eslint": "8.39.0",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "^1.0.0-beta.15",
    "pino-pretty": "^13.2.0",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": "^18.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^18.0.8",
    "got": "^16.0.0",
    "inversify": "^8.2.3",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2"
  }
}
